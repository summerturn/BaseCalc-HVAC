# BaseCalc HVAC environment variables
# Copy this file to .env and fill in real values.

# RevenueCat
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=your_ios_public_key
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=your_android_public_key

# Google AdMob. Set test mode only for a local/internal preview and supply Google's
# sample app IDs. Production requires six real IDs from the managed EAS environment.
BASECALC_ADS_TEST_MODE=false
BASECALC_ADS_PRODUCTION=false
ADMOB_IOS_APP_ID=
ADMOB_ANDROID_APP_ID=
EXPO_PUBLIC_ADMOB_IOS_BANNER_ID=
EXPO_PUBLIC_ADMOB_ANDROID_BANNER_ID=
EXPO_PUBLIC_ADMOB_IOS_REWARDED_ID=
EXPO_PUBLIC_ADMOB_ANDROID_REWARDED_ID=
